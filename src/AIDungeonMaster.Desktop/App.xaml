<Application x:Class="AIDungeonMaster.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="AppBgColor">#FF0F172A</Color>
            <Color x:Key="CardColor">#FF111827</Color>
            <Color x:Key="AccentColor">#FF38BDF8</Color>
            <Color x:Key="Accent2Color">#FFF59E0B</Color>
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBgColor}" />
            <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="Accent2Brush" Color="{StaticResource Accent2Color}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
